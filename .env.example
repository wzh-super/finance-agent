# Copy to .env and fill in values from your OpenAI-compatible API provider.
# Keep this template free of credentials; .env is ignored by Git.
# Keep .env alongside run.py and run commands from the project root.
# Chat and embeddings currently share this endpoint and API key.
OPENAI_API_KEY=
CHAT_MODEL=your-chat-model
EMBEDDING_MODEL=your-embedding-model

# Optional: uncomment for a provider other than the default OpenAI endpoint.
# Include the API version path required by your provider, for example /v1.
# OPENAI_API_BASE=https://your-provider.example/v1
